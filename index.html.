<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Custom 12-Day Art Advent Calendar</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #0b0f19;
            --bg-card: #131c2e;
            --bg-card-hover: #1a2640;
            --accent-gold: #f59e0b;
            --accent-gold-glow: rgba(245, 158, 11, 0.4);
            --accent-red: #ef4444;
            --accent-red-glow: rgba(239, 68, 68, 0.4);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --border-color: rgba(255, 255, 255, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem 1rem;
            position: relative;
            overflow-x: hidden;
        }

        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .container {
            width: 100%;
            max-width: 1050px;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        header {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        h1 {
            font-family: 'Cinzel', serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 900;
            background: linear-gradient(135deg, #fff 30%, var(--accent-gold) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
            letter-spacing: 1px;
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 1rem;
            max-width: 500px;
            margin: 0 auto 1.5rem auto;
            line-height: 1.5;
        }

        .controls-bar {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            background: var(--bg-card);
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            border: 1px solid var(--border-color);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .toggle-container {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            user-select: none;
        }

        .toggle-switch {
            width: 48px;
            height: 26px;
            background: #374151;
            border-radius: 13px;
            position: relative;
            transition: background 0.3s ease;
        }

        .toggle-switch::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 20px;
            height: 20px;
            background: #fff;
            border-radius: 50%;
            transition: transform 0.3s ease;
        }

        input[type="checkbox"] {
            display: none;
        }

        input[type="checkbox"]:checked + .toggle-container .toggle-switch {
            background: var(--accent-gold);
        }

        input[type="checkbox"]:checked + .toggle-container .toggle-switch::after {
            transform: translateX(22px);
        }

        .toggle-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .master-key-btn {
            background: linear-gradient(135deg, var(--accent-gold), #d97706);
            color: #000;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 15px var(--accent-gold-glow);
        }

        .master-key-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px var(--accent-gold-glow);
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            width: 100%;
            margin-bottom: 3rem;
        }

        .box {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            aspect-ratio: 1;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }

        .box.size-small {
            grid-column: span 1;
            grid-row: span 1;
        }

        .box.size-tall {
            grid-column: span 1;
            grid-row: span 2;
            aspect-ratio: auto;
        }

        .box.size-wide {
            grid-column: span 2;
            grid-row: span 1;
            aspect-ratio: auto;
            min-height: 150px;
        }

        .box.size-grand {
            grid-column: span 4;
            grid-row: span 2;
            aspect-ratio: auto;
            min-height: 280px;
            background: linear-gradient(135deg, #131c2e, #1f1b2c);
            border: 2px solid rgba(245, 158, 11, 0.3);
        }

        .box:hover {
            transform: translateY(-4px);
            border-color: rgba(245, 158, 11, 0.4);
            box-shadow: 0 12px 35px rgba(0,0,0,0.5);
            background: var(--bg-card-hover);
        }

        .box::before {
            content: '';
            position: absolute;
            background: rgba(245, 158, 11, 0.15);
            pointer-events: none;
        }

        .box.size-small::before { width: 14px; height: 100%; left: 50%; transform: translateX(-50%); }
        .box.size-tall::before { width: 100%; height: 14px; top: 50%; transform: translateY(-50%); }
        .box.size-wide::before { width: 14px; height: 100%; left: 30%; transform: translateX(-50%); }
        .box.size-grand::before { width: 20px; height: 100%; left: 50%; transform: translateX(-50%); background: rgba(245, 158, 11, 0.25); }

        .day-number {
            font-family: 'Cinzel', serif;
            font-size: clamp(1.5rem, 2.5vw, 2.2rem);
            font-weight: 700;
            color: var(--accent-gold);
            margin-bottom: 0.25rem;
            z-index: 2;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }

        .box-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            z-index: 2;
            text-align: center;
            padding: 0 0.5rem;
        }

        .box.size-grand .day-number {
            font-size: 3rem;
        }
        .box.size-grand .box-label {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--accent-gold);
        }

        .box.unlocked .preview-thumb {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.35;
            transition: opacity 0.3s, transform 0.5s;
        }

        .box.unlocked:hover .preview-thumb {
            opacity: 0.6;
            transform: scale(1.05);
        }

        .box.unlocked .day-number,
        .box.unlocked .box-label {
            z-index: 3;
            text-shadow: 0 2px 8px rgba(0,0,0,0.9);
        }

        .box.unlocked {
            border-color: var(--accent-gold);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(5, 7, 12, 0.85);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            padding: 1rem;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            width: 100%;
            max-width: 650px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 2rem;
            position: relative;
            transform: scale(0.95);
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 25px 50px rgba(0,0,0,0.7);
        }

        .modal-overlay.active .modal-content {
            transform: scale(1);
        }

        .close-btn {
            position: absolute;
            top: 1.25rem;
            right: 1.25rem;
            background: rgba(255,255,255,0.08);
            border: none;
            color: var(--text-main);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
            z-index: 10;
        }

        .close-btn:hover {
            background: rgba(255,255,255,0.2);
        }

        .modal-header {
            font-family: 'Cinzel', serif;
            font-size: 1.5rem;
            color: var(--accent-gold);
            margin-bottom: 1rem;
            padding-right: 2rem;
        }

        .modal-img-container {
            width: 100%;
            border-radius: 14px;
            overflow: hidden;
            background: #000;
            margin-bottom: 1.25rem;
            border: 1px solid var(--border-color);
            max-height: 450px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-img {
            width: 100%;
            height: auto;
            max-height: 450px;
            object-fit: contain;
            display: block;
        }

        .modal-note {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 1.5rem;
            background: rgba(255,255,255,0.03);
            padding: 1rem;
            border-radius: 12px;
            border-left: 3px solid var(--accent-gold);
        }

        .download-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            background: var(--text-main);
            color: var(--bg-deep);
            padding: 0.85rem;
            border-radius: 12px;
            font-weight: 700;
            text-decoration: none;
            transition: background 0.2s, transform 0.2s;
        }

        .download-btn:hover {
            background: var(--accent-gold);
            transform: translateY(-2px);
        }

        @media (max-width: 768px) {
            .calendar-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .box.size-tall {
                grid-column: span 1;
                grid-row: span 1;
                aspect-ratio: 1;
            }
            .box.size-wide {
                grid-column: span 2;
                grid-row: span 1;
            }
            .box.size-grand {
                grid-column: span 2;
                grid-row: span 2;
            }
        }
    </style>
</head>
<body>

    <canvas id="particle-canvas"></canvas>

    <div class="container">
        <header>
            <h1>12-Day Art Advent</h1>
            <p class="subtitle">Click your unlocked boxes to inspect your custom Skeb sketches, or use the master key to binge the whole gallery instantly.</p>
            
            <div class="controls-bar">
                <input type="checkbox" id="bingeToggle" onchange="toggleBingeMode()">
                <label for="bingeToggle" class="toggle-container">
                    <div class="toggle-switch"></div>
                    <span class="toggle-label" id="toggleText">Advent Countdown Mode</span>
                </label>
                <button class="master-key-btn" onclick="masterUnlock()">🔑 Unlock All Now</button>
            </div>
        </header>

        <div class="calendar-grid" id="calendarGrid"></div>
    </div>

    <div class="modal-overlay" id="artModal" onclick="closeModalOnBg(event)">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">&times;</button>
            <h2 class="modal-header" id="modalTitle">Day Title</h2>
            <div class="modal-img-container">
                <img class="modal-img" id="modalImg" src="" alt="Skeb artwork preview">
            </div>
            <p class="modal-note" id="modalNote">Artist note goes here...</p>
            <a href="#" class="download-btn" id="modalDownload" download target="_blank">Download High-Res Artwork</a>
        </div>
    </div>

    <script>
        const adventData = [
            { id: 1, size: "size-small", title: "Day 1: Morning Coffee Sketch", artUrl: "https://images.unsplash.com/photo-1543589077-47d81606c1bf?auto=format&fit=crop&w=800&q=80", note: "Starting off cozy! Hope you love this first quick character warmup.", unlocked: true },
            { id: 2, size: "size-tall", title: "Day 2: Winter Coat Variant", artUrl: "https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=800&q=80", note: "Experimenting with fluffier outerwear and expressive linework.", unlocked: false },
            { id: 3, size: "size-small", title: "Day 3: Chibi Expressions", artUrl: "https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=800&q=80", note: "A set of quick chibi face reactions under 30 minutes!", unlocked: false },
            { id: 4, size: "size-wide", title: "Day 4: Dynamic Action Pose", artUrl: "https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=800&q=80", note: "Leaning into bold ink strokes for maximum movement energy.", unlocked: false },
            { id: 5, size: "size-small", title: "Day 5: Snack Break Doodle", artUrl: "https://images.unsplash.com/photo-1563089145-599997674d42?auto=format&fit=crop&w=800&q=80", note: "Quick snack break sketch before tackling the next batch.", unlocked: false },
            { id: 6, size: "size-tall", title: "Day 6: Casual Loungewear", artUrl: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80", note: "Relaxed vibes and messy hair aesthetic.", unlocked: false },
            { id: 7, size: "size-small", title: "Day 7: Glowing Magic FX", artUrl: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80", note: "Playing with vibrant cyan and gold lighting accents.", unlocked: false },
            { id: 8, size: "size-wide", title: "Day 8: Duo Close-Up", artUrl: "https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80", note: "A tighter crop focusing on eye expression and mood.", unlocked: false },
            { id: 9, size: "size-small", title: "Day 9: Accessory Study", artUrl: "https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=800&q=80", note: "Detailed breakdown of the custom charm bag design.", unlocked: false },
            { id: 10, size: "size-tall", title: "Day 10: Dramatic Lighting", artUrl: "https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=800&q=80", note: "Heavy shadow contrasts to create high psychological tension.", unlocked: false },
            { id: 11, size: "size-small", title: "Day 11: Final Countdown Prep", artUrl: "https://images.unsplash.com/photo-1543589077-47d81606c1bf?auto=format&fit=crop&w=800&q=80", note: "Almost at the finish line! Getting ready for the grand finale.", unlocked: false },
            { id: 12, size: "size-grand", title: "Day 12: Grand Finale (Full-Body Masterpiece)", artUrl: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80", note: "The crown jewel of the calendar! A fully rendered full-body illustration wrapping up the 12-day journey.", unlocked: false }
        ];

        let bingeMode = false;

        function renderGrid() {
            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            adventData.forEach(item => {
                const box = document.createElement('div');
                box.className = `box ${item.size} ${item.unlocked ? 'unlocked' : ''}`;
                box.onclick = () => openBox(item.id);

                let content = `<div class="day-number">#${item.id}</div>`;
                if (item.size === 'size-grand') {
                    content += `<div class="box-label">${item.title}</div>`;
                } else {
                    content += `<div class="box-label">${item.unlocked ? 'Unlocked' : 'Locked'}</div>`;
                }

                if (item.unlocked) {
                    content += `<img class="preview-thumb" src="${item.artUrl}" alt="Thumbnail">`;
                }

                box.innerHTML = content;
                grid.appendChild(box);
            });
        }

        function toggleBingeMode() {
            bingeMode = document.getElementById('bingeToggle').checked;
            document.getElementById('toggleText').innerText = bingeMode ? "Binge Mode (All Open)" : "Advent Countdown Mode";
            
            adventData.forEach(item => {
                if (bingeMode) item.unlocked = true;
            });
            renderGrid();
        }

        function masterUnlock() {
            document.getElementById('bingeToggle').checked = true;
            bingeMode = true;
            document.getElementById('toggleText').innerText = "Binge Mode (All Open)";
            adventData.forEach(item => item.unlocked = true);
            renderGrid();
        }

        function openBox(id) {
            const item = adventData.find(d => d.id === id);
            if (!item.unlocked && !bingeMode) {
                alert(`Day #${id} is still locked! Turn on Binge Mode or use the Master Key to open it early.`);
                return;
            }

            document.getElementById('modalTitle').innerText = item.title;
            document.getElementById('modalImg').src = item.artUrl;
            document.getElementById('modalNote').innerText = item.note;
            document.getElementById('modalDownload').href = item.artUrl;

            document.getElementById('artModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('artModal').classList.remove('active');
        }

        function closeModalOnBg(event) {
            if (event.target.id === 'artModal') {
                closeModal();
            }
        }

        const canvas = document.getElementById('particle-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        for (let i = 0; i < 35; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                radius: Math.random() * 1.5 + 0.5,
                speedY: (Math.random() * 0.4 + 0.1) * -1,
                opacity: Math.random() * 0.5 + 0.2
            });
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#f59e0b';

            particles.forEach(p => {
                ctx.globalAlpha = p.opacity;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();

                p.y += p.speedY;
                if (p.y < 0) {
                    p.y = canvas.height;
                    p.x = Math.random() * canvas.width;
                }
            });

            requestAnimationFrame(animateParticles);
        }

        animateParticles();
        renderGrid();
    </script>
</body>
</html>
